# =========================================================================
# NearExpiry — Docker Compose Environment Variables Template
# Copy this file to .env before starting containers:
#   cp .env.docker.example .env
# =========================================================================

# -------------------------------------------------------------------------
# Host Port Mapping
# -------------------------------------------------------------------------
PORT_FRONTEND=80
PORT_BACKEND=5000
PORT_MONGODB=27017
PORT_REDIS=6379

# -------------------------------------------------------------------------
# Application Environment & Runtime
# -------------------------------------------------------------------------
NODE_ENV=production
API_PREFIX=/api/v1

# -------------------------------------------------------------------------
# Container Networking & Hostnames (Internal Compose DNS)
# -------------------------------------------------------------------------
# The backend communicates with MongoDB and Redis via internal service DNS names
MONGODB_URI=mongodb://mongodb:27017/nearexpiry

# Optional MongoDB credentials (uncomment if enabling root authentication)
# MONGO_INITDB_ROOT_USERNAME=nearexpiry_admin
# MONGO_INITDB_ROOT_PASSWORD=change_this_to_a_secure_mongo_password_here
# MONGO_INITDB_DATABASE=nearexpiry

# -------------------------------------------------------------------------
# CORS & Web Client Domains
# -------------------------------------------------------------------------
# Comma-separated list of allowed origins. In Docker, this includes frontend published port.
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173
CLIENT_URL=http://localhost

# -------------------------------------------------------------------------
# Cryptographic Secrets & JWT Tokens (MANDATORY IN PRODUCTION)
# -------------------------------------------------------------------------
# Replace all placeholders below with cryptographically random strings (min 32 chars)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_cryptographically_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_cryptographically_secure_random_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d
QR_SIGNING_SECRET=replace_with_cryptographically_secure_random_qr_signing_secret_min_32_chars
BCRYPT_SALT_ROUNDS=12

# -------------------------------------------------------------------------
# Rate Limiting
# -------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# -------------------------------------------------------------------------
# Redis Caching (Phase 23)
# -------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# -------------------------------------------------------------------------
# Frontend Build Arguments (Baked into client bundle by Vite during build)
# -------------------------------------------------------------------------
# By default, use relative /api/v1 so Nginx reverse-proxies directly without CORS
VITE_API_URL=/api/v1
# Empty value allows Socket.IO to resolve to window.location.origin via Nginx proxy
VITE_SOCKET_URL=

