# =========================================================================
# NearExpiry — Root Environment Variables Template
# See .env.docker.example for full containerized deployments
# =========================================================================

# Server & Database
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/nearexpiry

# Frontend & CORS
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Security Secrets (Must be changed in production)
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_super_secret_jwt_refresh_key_32_chars
JWT_REFRESH_EXPIRES_IN=30d
QR_SIGNING_SECRET=change_me_super_secret_qr_signature_key_32_chars
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Redis Caching
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

